{
  "expo": {
    "name": "ToDoList_JCox",
    "slug": "ToDoList_JCox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/OU.png",
    "scheme": "todolistjcox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/OU.png"
    },
    "android": {
          "package": "com.example.todoapp",
      "adaptiveIcon": {
        "backgroundColor": "#DC143C",
        "foregroundImage": "./assets/images/OU.png",
        "backgroundImage": "./assets/images/OU.png",
        "monochromeImage": "./assets/images/OU.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/CoyoteIcon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
